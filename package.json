{
  "name": "gh-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --dir storefront install --frozen-lockfile && pnpm --dir storefront run build && node scripts/setup-wrangler-redirect.mjs",
    "dev": "pnpm --dir storefront run dev",
    "dev:background": "./scripts/dev.sh --background",
    "dev:stop": "./scripts/stop.sh",
    "start": "pnpm --dir storefront exec vite preview",
    "lint": "eslint",
    "test": "vitest run && vitest run --config storefront/vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "pnpm --dir storefront run typecheck",
    "build:cloudflare": "pnpm run build",
    "preview": "pnpm --dir storefront run preview",
    "deploy": "pnpm run build && pnpm --dir storefront exec wrangler deploy",
    "upload": "pnpm run build && pnpm --dir storefront exec wrangler versions upload",
    "versions": "pnpm --dir storefront exec wrangler versions list",
    "rollback": "pnpm --dir storefront exec wrangler rollback",
    "cf-typegen": "pnpm --dir storefront run cf-typegen",
    "opennextjs-cloudflare": "node scripts/opennextjs-cloudflare-shim.mjs",
    "check": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "supabase": "^2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  },
  "packageManager": "pnpm@11.17.0"
}
