/**
 * Production worker: gh-store.
 *
 * Same worker name, routes, and account as the legacy Next/OpenNext deployment
 * it replaces, so the cutover is a code change rather than an infrastructure
 * change: custom domains, secrets, and the cron trigger all stay attached.
 * Secrets (SUPABASE_SERVICE_ROLE_KEY, RECONCILE_CRON_SECRET) are set on the
 * worker itself and must never be added to `vars` here.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gh-store",
	"account_id": "5c885c3c858ff52e420d04dfb76e9377",
	"compatibility_date": "2026-09-03",
	"main": "./workers/app.ts",
	// Static client build (CSS/JS/images) is served as Worker Assets; the
	// worker handles only HTML and API routes. Without this the page renders
	// unstyled because /assets/* requests 404.
	"assets": {
		"directory": "./build/client"
	},
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"placement": { "mode": "smart" },
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		}
	},
	"vars": {
		"SUPABASE_URL": "https://njlzgfddfnnqujaodbta.supabase.co",
		"SUPABASE_PUBLISHABLE_KEY": "sb_publishable_gtOxP1au24qFXwzVppy0vw_oFWaSIH2",
		"APP_URL": "https://gh-store.me"
	},
	// Keep the workers.dev URL alive as a test address; declaring custom
	// domains switches it off otherwise.
	"workers_dev": true,
	"routes": [
		{ "pattern": "gh-store.me", "custom_domain": true },
		{ "pattern": "www.gh-store.me", "custom_domain": true }
	],
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	// CPU limit is omitted on purpose: the destination account is on the Free
	// plan and deploying with cpu_ms fails (code 100328). Re-add after upgrading
	// to Workers Paid:
	//   "limits": { "cpu_ms": 60000 },
	"images": {
		"binding": "IMAGES"
	}
}
