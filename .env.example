# Public Supabase configuration. Safe for browser use with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Google Search Console verification token (optional). Rendered as a meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Plausible Analytics domain (optional), e.g. gh-store.me. A build-time value:
# set it where the production build runs (Workers Builds env or .env.local).
# Unset means the analytics script is not rendered at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Server-only values. Keep empty locally until the related integration exists.
# Each one is a fallback: a key saved in the dashboard (store_settings) wins.
SUPABASE_SERVICE_ROLE_KEY=
G2BULK_API_KEY=
SAM_API_KEY=
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
BINANCE_PAY_WEBHOOK_SECRET=

# Supplier API tokens. Same rule: dashboard saves win, these fill the gap.
MAXSTORE_API_TOKEN=
BATSTORE_API_TOKEN=

# BatStore API host override (optional). The default is the supplier's Railway
# deployment URL; set this when they move to their own domain, without a redeploy.
BATSTORE_API_BASE_URL=

# Shared secret for the scheduled fulfilment sweep at POST /api/reconcile.
# The sweep only polls the supplier, but it can settle and refund an order,
# so the endpoint is useless without this and refuses every call until it is set.
RECONCILE_CRON_SECRET=

# Browser suite only (optional). A real administrator in the project's auth,
# used by the e2e setup project to sign in through the /ar/login form. When
# absent, the admin cases skip and only the anonymous suite runs.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
